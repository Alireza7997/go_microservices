# Copy this file to `env.yaml` and fill in real values.
# NEVER commit the real env.yaml.

# If you change debug to false, don't forget to
# add a database with its name equal to "main"
debug: true

domain: "http://localhost:6000"

# A good rule of thumb is 1 concurrent = 1000 monthly visits for the typical website or app.
max_concurrent_requests: 10

allow_origins: "*" # or a comma-separated list of origins

allow_headers: "Token"

gateway:
  ip: 0.0.0.0
  port: 6000

microservices:
  auth:
    # Use 0.0.0.0 when running inside Docker
    ip: 127.0.0.1
    port: 6001
    databases:
      test:
        type: "postgres"
        username: "<db_user>"
        password: "<db_password>"
        db_name: "authDB"
        host: "localhost"
        port: "5432"
        ssl_mode: "disable"
        time_zone: "Asia/Tehran"
        charset: "utf8mb4"

  chat:
    ip: 127.0.0.1
    port: 6002

  greet:
    ip: 127.0.0.1
    port: 6003

secret_key: "<jwt_secret>" # generate with: openssl rand -hex 32
